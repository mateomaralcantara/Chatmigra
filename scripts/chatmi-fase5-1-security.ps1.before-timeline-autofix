# ============================================================

Section "2. REPARANDO TIMELINE.TSX"

$backupBase = Join-Path `
    $ProjectRoot `
    ".hardening-backups"

$latestPhase5 = Get-ChildItem `
    -LiteralPath $backupBase `
    -Directory `
    -ErrorAction SilentlyContinue |
    Where-Object {
        $_.Name -like "fase5-*"
    } |
    Sort-Object LastWriteTime -Descending |
    Select-Object -First 1

if (!$latestPhase5) {
    throw "No encontré backup fase5-*."
}

$backupTimeline = Join-Path `
    $latestPhase5.FullName `
    "src\components\Timeline.tsx"

$currentTimeline = Join-Path `
    $ProjectRoot `
    "src\components\Timeline.tsx"

if (!(Test-Path $backupTimeline)) {
    throw "No existe Timeline.tsx dentro del backup Fase 5."
}

Copy-Item `
    $backupTimeline `
    $currentTimeline `
    -Force

OK "Timeline.tsx restaurado desde:"
Write-Host "    $($latestPhase5.FullName)" -ForegroundColor DarkGray

# ============================================================
